# Website Bug Hunter — environment variable examples.
#
# Copy this file to `.env` and adjust as needed. The scanner uses
# only one environment variable, but we expose it through the example
# so operators on platforms that prefer .env files can document their
# choice alongside the binary.
#
# Real `.env` files are excluded from git via .gitignore. Do not put
# secrets here — WBH does not require any.

# Pino log level for the CLI.
#   debug  — verbose, includes per-page fetch traces
#   info   — default
#   warn   — warnings and errors only
#   error  — fatal-only mode (this is what --quiet maps to at runtime)
# WBH_LOG_LEVEL=info
