# Dependencies
node_modules/

# Build output
dist/

# Test artefacts (vitest coverage, etc.)
coverage/

# Local env / secrets — never commit
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# pnpm
.pnpm-store/

# Build cache (tsc)
*.tsbuildinfo

# Sample / generated reports in the working tree (keep them out of git;
